# =============================================================================
# EventSphere Environment Variables Checklist (.env.example)
# Copy this file to '.env' and fill in your actual credentials for local development.
# DO NOT commit '.env' containing real secrets to version control.
# =============================================================================

# --- Server HTTP Port ---
PORT=8080

# --- Database Credentials (Aiven Managed MySQL or Local MySQL) ---
DB_URL=jdbc:mysql://your-mysql-host:3306/your-database?sslMode=REQUIRED
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# --- Security & JWT Keys ---
JWT_SECRET=your_jwt_secret_key_at_least_32_bytes_long
JWT_EXPIRATION_MS=86400000
TICKET_QR_SECRET=your_ticket_qr_signing_secret_key

# --- Google Gemini AI API Credentials ---
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# --- SMTP Email Credentials (Gmail) ---
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587

# --- PayHere IPG Credentials & Webhooks ---
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=your_payhere_merchant_id
PAYHERE_MERCHANT_SECRET=your_payhere_merchant_secret
PAYHERE_RETURN_URL=http://localhost:8000/pages/my-bookings.html
PAYHERE_CANCEL_URL=http://localhost:8000/pages/my-bookings.html
PAYHERE_NOTIFY_URL=http://localhost:7080/api/v1/payments/notify

# --- Admin Seeding Credentials ---
ADMIN_EMAIL=admin@eventsphere.lk
ADMIN_PASSWORD=your_initial_admin_password

# --- CORS Allowed Origins ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:5500,http://localhost:3000,http://127.0.0.1:5500,http://127.0.0.1:8000,http://localhost:8000
